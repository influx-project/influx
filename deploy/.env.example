# Production settings. Copy to deploy/.env and fill in every value marked "required".
# Connection details for Postgres, Redis and Reverb are set in compose.yaml.

# --- Site -------------------------------------------------------------------------------

APP_NAME="Influx"

# Required. Generate with:
#   docker compose run --rm --no-deps migrate php artisan key:generate --show
APP_KEY=

APP_DEBUG=false

# Required. The address people use to reach the site, with http:// or https://.
APP_URL=https://monitor.example.com

# What the web server listens as. This is what turns HTTPS on or off:
#   With SSL:    your domain, e.g. monitor.example.com (a Let's Encrypt certificate is
#                issued automatically; the domain's DNS must point at this server and
#                ports 80 and 443 must be reachable)
#   Without SSL: :80
SERVER_NAME=monitor.example.com

# Optional. Extra Caddy global options, e.g. an email for Let's Encrypt expiry notices.
CADDY_GLOBAL_OPTIONS="email admin@example.com"

# Optional. Extra directives for the site, e.g. to use your own certificate files
# (mounted into the web container, see README.md) instead of Let's Encrypt:
# CADDY_SERVER_EXTRA_DIRECTIVES="tls /certs/fullchain.pem /certs/privkey.pem"

# Host ports to publish. Change these if something else on the server already uses them.
HTTP_PORT=80
HTTPS_PORT=443

# Mark session cookies secure (HTTPS only). Set to false when running without SSL.
SESSION_SECURE_COOKIE=true

# Optional. Only when another load balancer or reverse proxy in front of this stack
# terminates TLS: its IP addresses (comma separated), or * to trust any.
TRUSTED_PROXIES=

LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------------------

DB_DATABASE=influx
DB_USERNAME=influx
# Required. A long random password, e.g. from: openssl rand -hex 24
DB_PASSWORD=

# --- Live updates (Reverb) --------------------------------------------------------------

# Required. Random values, e.g.:
#   REVERB_APP_ID:     openssl rand -hex 4 | tr -d 'a-f' | head -c 6   (any number works)
#   REVERB_APP_KEY:    openssl rand -hex 16
#   REVERB_APP_SECRET: openssl rand -hex 32
# The key is public (browsers use it to connect); keep the secret private.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- Mail (optional) --------------------------------------------------------------------
# Used for password reset and email verification.

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="monitor@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Image ------------------------------------------------------------------------------

# Name and tag for the built image; change to use one pushed to your own registry.
APP_IMAGE=influx-project
APP_TAG=latest
